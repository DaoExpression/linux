#!/bin/ksh
#
#	lab-report - a readable digest of what the lab is doing
#
#	Installed to /usr/local/sbin/lab-report and run from /etc/crontab:
#	    lab-report weekly      Monday 06:00
#	    lab-report monthly     1st of the month, 07:00
#
#	Output is plain text on stdout, so cron(8) mails it to root and the
#	gateway's smtpd(8) relays it to the mail guest.  Nothing else is needed:
#	no agent, no web UI, no database.
#
#	The purpose is not to be pretty — it is to be the thing that tells you
#	something changed before a user does.

set -u

MODE=${1:-weekly}
HOST=$(hostname)
NOW=$(date '+%Y-%m-%d %H:%M %Z')

hdr() { printf '\n== %s\n' "$*"; }

cat <<EOF
lab report for $HOST — $MODE — $NOW
generated by /usr/local/sbin/lab-report
EOF

hdr "hosts"
# Every host answers ICMP: the quickest way to see which guest is missing from
# a report is to ping it and notice that it is in this list and not the next.
for pair in \
	"gw 10.10.50.1" \
	"bastion 10.10.50.10" \
	"dns 10.10.50.11" \
	"db 10.10.50.12" \
	"storage 10.10.50.13" \
	"mon 10.10.50.14" \
	"web 10.10.40.20" \
	"mail 10.10.40.21"
do
	name=${pair% *}; addr=${pair#* }
	if ping -c1 -w1 "$addr" >/dev/null 2>&1; then
		printf '  %-10s %-15s up\n' "$name" "$addr"
	else
		printf '  %-10s %-15s DOWN\n' "$name" "$addr"
	fi
done

hdr "virtual machines"
vmctl status 2>/dev/null || echo "  vmctl(8) unavailable"

hdr "firewall"
pfctl -si 2>/dev/null | awk '/^Status:/ || /^State Table/ || /current entries/'
printf '  rules: '
pfctl -sr 2>/dev/null | wc -l | tr -d ' '
printf '\n  most active rules (packets):\n'
pfctl -vsr 2>/dev/null |
	awk '/^pass|^block/ { rule = $0; getline; gsub(/^[ \t]+/, ""); print }' |
	grep -E '^\[ Evaluations' | sort -rn -t' ' -k3 | head -5 || true

hdr "interfaces"
ifconfig -A 2>/dev/null |
	awk '/^[a-z]/{iface=$1} /inet /{print "  " iface " " $2}' |
	head -20

hdr "listening services"
# "What is actually listening" is the question every incident starts with.
netstat -Ln 2>/dev/null | awk '/^tcp|^udp/ {print "  " $0}' | head -25 || \
	ss -Ln 2>/dev/null | head -25 || echo "  (no socket listing available)"

hdr "runaway processes"
ps -axo pid,pcpu,pmem,comm 2>/dev/null | sort -rn -k2 | head -8 | sed 's/^/  /'

hdr "disks"
df -h 2>/dev/null | sed 's/^/  /'

hdr "DNS"
if [ -x /usr/sbin/nsd-control ]; then
	nsd-control status 2>/dev/null | sed 's/^/  /' || echo "  nsd-control: not responding"
fi
printf '  zone serial: '
awk '/\);/{getline; print $1; exit}' /var/nsd/zones/lab.example.org.zone 2>/dev/null ||
	echo "(zone file unreadable)"

hdr "certificates"
for crt in /etc/ssl/*.crt; do
	[ -f "$crt" ] || continue
	exp=$(openssl x509 -enddate -noout -in "$crt" 2>/dev/null | cut -d= -f2)
	sub=$(openssl x509 -subject -noout -in "$crt" 2>/dev/null | sed 's/^subject=//')
	printf '  %-40s expires %s\n' "$sub" "$exp"
done

hdr "backups"
# The newest backup per host, so a silently failing job is visible here rather
# than the day someone needs a restore.
for host in gw bastion dns db storage mon web mail; do
	d=/var/backup/$host
	if [ -d "$d" ]; then
		newest=$(ls -1dt "$d"/*/ 2>/dev/null | head -1)
		printf '  %-10s %s\n' "$host" "${newest:-none}"
	else
		printf '  %-10s no backups yet\n' "$host"
	fi
done

hdr "package updates"
# Count packages with a newer version in the repository; it is a two-line
# answer to "are we patched?" without pulling anything.
if [ -x /usr/sbin/pkg_info ]; then
	/usr/sbin/pkg_info -q -u 2>/dev/null | sed 's/^/  /' | head -20 ||
		echo "  (could not query the package repository)"
fi

if [ "$MODE" = monthly ]; then
	hdr "monthly: full pf ruleset"
	pfctl -sr 2>/dev/null | sed 's/^/  /'
	hdr "monthly: full NAT ruleset"
	pfctl -sn 2>/dev/null | sed 's/^/  /'
	hdr "monthly: package inventory"
	pkg_info 2>/dev/null | sed 's/^/  /' | head -50
	hdr "monthly: last 40 authentication failures"
	grep -i 'failed\|invalid' /var/log/authlog 2>/dev/null | tail -40 | sed 's/^/  /'
fi

cat <<'EOF'

--
To change what appears here, edit /usr/local/sbin/lab-report; to change when it
runs, edit /etc/crontab.  This report is deliberately generated on the gateway
rather than the monitoring guest, so that it still arrives when a guest is the
thing that is broken.
EOF

exit 0
