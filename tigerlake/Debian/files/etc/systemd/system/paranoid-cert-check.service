# /etc/systemd/system/paranoid-cert-check.service
# Daily certificate-expiry and key-permission check. See docs/06 §4 and docs/10 §1.
#
# Logic lives in /usr/local/sbin/paranoid-cert-check (a unit cannot contain printf '%s' format
# strings - systemd would parse %s as an invalid specifier and refuse to start the unit).
#
# Verify:  systemd-analyze verify /etc/systemd/system/paranoid-cert-check.service
# Test:    sudo PARANOID_CERTDIR=/tmp/certs PARANOID_LOGDIR=/tmp/cc /usr/local/sbin/paranoid-cert-check

[Unit]
Description=Check TLS certificate expiry and private key permissions
Documentation=file:///etc/paranoid/README.md
After=local-fs.target
Conflicts=paranoid-cert-check.timer

[Service]
Type=oneshot
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=yes
# AF_UNIX only: the certificate files are read locally; no OCSP or network lookup is performed.
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete @mount @debug @cpu-emulation @swap @keyring
ReadWritePaths=/var/log/paranoid
ReadOnlyPaths=/etc/letsencrypt /etc/ssl
UMask=0027

ExecStartPre=/bin/mkdir -p /var/log/paranoid
ExecStart=/usr/local/sbin/paranoid-cert-check

[Install]
WantedBy=multi-user.target
