#	dns — resolver for the lab, 10.10.50.11 on the srv segment.
#
#	Clients are pointed here by the gateway's dhcpd.conf and by radvd, and by
#	the per-guest resolv.conf deployed to every other VM.
inet 10.10.50.11 255.255.255.0 10.10.50.255
inet6 fd00:10:10:50::11 64
!route add default 10.10.50.1
!route add -inet6 default fd00:10:10:50::1
up
