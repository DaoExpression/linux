# =============================================================================
# tigerlake.config
# Kernel configuration fragment for the machine described in TigerLake_PCI.txt
#
# Target: Dell laptop, Intel 11th Gen Core (Tiger Lake-UP3/H35, 4 cores)
#   - Intel Iris Xe (TigerLake-LP GT2), i915              [00:02.0]
#   - NVIDIA TU117M GeForce MX450, nouveau (in-tree)     [01:00.0]
#   - Thunderbolt 4 (USB4 + xHCI NHI)                    [00:07.0 00:0d.0/.2]
#   - Intel Wi-Fi 6 AX201 (iwlwifi) + Bluetooth          [00:14.3]
#   - ADATA IM2P33F3 NVMe SSD                            [3a:00.0]
#   - Intel SOF Smart Sound audio                        [00:1f.3]
#   - Intel ISH, MEI, LPSS Serial IO, SMBus, SPI         [00:12 00:16 00:15 00:1f]
#   - Intel IOMMU/VT-d, Dynamic Tuning thermal, igen6 EDAC
# Init system: OpenRC
#
# Apply with scripts/kconfig/merge_config.sh (see apply-config.sh).
#
# Notes on symbol names that moved between kernel releases:
#   * x86_64 processor family: older trees used CONFIG_MCORE2; current trees
#     use CONFIG_X86_NATIVE_CPU. Both are listed so either tree resolves.
#   * Intel MEI-over-WLAN (IWLMEI) is intentionally omitted: it depends on
#     BROKEN and is not a supported/shippable driver.
#   * Debug info is a choice now; CONFIG_DEBUG_INFO is derived.
# `make olddefconfig` drops any symbol absent from your tree and settles
# dependencies, so this file is safe to feed to any recent kernel.
# =============================================================================

# --- Platform / CPU ---------------------------------------------------------
CONFIG_SMP=y
CONFIG_X86_INTEL_PSTATE=y
CONFIG_X86_INTEL_MEMORY_PROTECTION_KEYS=y
CONFIG_INTEL_IDLE=y
# Modern trees: build/optimize for the local CPU. On pre-6.11 trees this
# symbol does not exist and CONFIG_MCORE2 below is used instead.
CONFIG_X86_NATIVE_CPU=y
CONFIG_MCORE2=y

# --- PCI / PCIe -------------------------------------------------------------
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCIEAER=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y

# --- IOMMU / VT-d (every device sits in an IOMMU group) ---------------------
CONFIG_IOMMU_SUPPORT=y
CONFIG_INTEL_IOMMU=y
CONFIG_INTEL_IOMMU_SVM=y
CONFIG_INTEL_IOMMU_DEFAULT_ON=y

# --- EDAC (00:00.0 igen6_edac) ---------------------------------------------
CONFIG_EDAC=y
CONFIG_EDAC_IGEN6=y

# --- Thermal / power management --------------------------------------------
CONFIG_PM=y
CONFIG_PM_SLEEP=y
CONFIG_SUSPEND=y
CONFIG_ACPI=y
CONFIG_ACPI_AC=y
CONFIG_ACPI_BATTERY=y
CONFIG_ACPI_FAN=y
CONFIG_ACPI_THERMAL=y
CONFIG_ACPI_VIDEO=y
CONFIG_ACPI_BUTTON=y
CONFIG_INTEL_POWERCLAMP=y
CONFIG_X86_PKG_TEMP_THERMAL=y
# 00:04.0 Dynamic Tuning Processor Participant (proc_thermal / INT340x)
CONFIG_INT340X_THERMAL=y
CONFIG_INTEL_RAPL_CORE=y
CONFIG_INTEL_RAPL=y
CONFIG_INTEL_UNCORE_FREQ_CONTROL=y

# --- Intel VSEC + PMT telemetry (00:0a.0, PMC) ------------------------------
CONFIG_INTEL_VSEC=y
CONFIG_INTEL_PMT_TELEMETRY=y
CONFIG_INTEL_PMC_CORE=y

# --- Graphics ---------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_I915=y
CONFIG_DRM_I915_USERPTR=y
CONFIG_DRM_NOUVEAU=y
CONFIG_DRM_NOUVEAU_BACKLIGHT=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_EFI=y
CONFIG_FB_VESA=y
CONFIG_DRM_FBDEV_OVERALLOC=100

# --- Backlight (handled by i915 on the eDP panel) ---------------------------
CONFIG_BACKLIGHT_CLASS_DEVICE=y

# --- Thunderbolt 4 / USB4 (00:07.0, 00:0d.2) --------------------------------
CONFIG_USB4=y
CONFIG_USB4_NET=y

# --- USB (00:0d.0, 00:14.0 xHCI) -------------------------------------------
CONFIG_USB=y
CONFIG_USB_SUPPORT=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_XHCI_PCI=y
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
CONFIG_USB_HID=y
CONFIG_USB_ACM=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# --- HID / input ------------------------------------------------------------
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HID_MULTITOUCH=y
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_INPUT_MOUSE=y
CONFIG_MOUSE_PS2=y
CONFIG_INPUT_MISC=y

# --- I2C / I2C-HID touchpad (via 00:15.x LPSS) ------------------------------
CONFIG_I2C=y
CONFIG_I2C_SMBUS=y
CONFIG_I2C_HID=y
CONFIG_I2C_HID_ACPI=y
CONFIG_I2C_I801=y

# --- Intel LPSS Serial IO + Tiger Lake pinctrl (00:15.x) --------------------
CONFIG_MFD_CORE=y
CONFIG_MFD_INTEL_LPSS=y
CONFIG_MFD_INTEL_LPSS_PCI=y
CONFIG_MFD_INTEL_LPSS_ACPI=y
CONFIG_PINCTRL=y
CONFIG_PINCTRL_TIGERLAKE=y

# --- SPI (00:1f.5 PCH/PCU SPI flash) ---------------------------------------
CONFIG_SPI=y
CONFIG_SPI_MEM=y
CONFIG_SPI_INTEL_PCI=y

# --- Intel MEI (00:16.0) ----------------------------------------------------
CONFIG_INTEL_MEI=y
CONFIG_INTEL_MEI_ME=y
CONFIG_INTEL_MEI_HDCP=y
CONFIG_INTEL_MEI_GSC=y

# --- Intel ISH (00:12.0) ----------------------------------------------------
CONFIG_INTEL_ISH_HID=y

# --- Bluetooth (integrated in the AX201) ------------------------------------
CONFIG_BT=y
CONFIG_BT_HCIBTUSB=y
CONFIG_BT_INTEL=y

# --- Wireless (00:14.3 Wi-Fi 6 AX201) --------------------------------------
CONFIG_CFG80211=y
CONFIG_CFG80211_DEBUGFS=y
CONFIG_MAC80211=y
CONFIG_MAC80211_DEBUGFS=y
CONFIG_RFKILL=y
CONFIG_RFKILL_INPUT=y
CONFIG_IWLWIFI=y
CONFIG_IWLMVM=y
CONFIG_IWLWIFI_DEBUGFS=y

# --- Audio (00:1f.3 SOF Smart Sound) ---------------------------------------
CONFIG_SOUND=y
CONFIG_SND=y
# SOF core and Intel platform support (Tiger Lake uses sof-audio-pci-intel-tgl)
CONFIG_SND_SOC=y
CONFIG_SND_SOC_SOF_TOPLEVEL=y
CONFIG_SND_SOC_SOF_PCI=y
CONFIG_SND_SOC_SOF_INTEL_TOPLEVEL=y
CONFIG_SND_SOC_SOF_TIGERLAKE=y
CONFIG_SND_SOC_SOF_HDA_LINK=y
CONFIG_SND_SOC_SOF_HDA_AUDIO_CODEC=y
# Machine drivers: HDA-codec based boards and the SoundWire generic machine
# (Dell Tiger Lake designs commonly use one of these).
CONFIG_SND_SOC_INTEL_USER_FRIENDLY_LONG_NAMES=y
CONFIG_SND_SOC_INTEL_SKL_HDA_DSP_GENERIC_MACH=y
CONFIG_SOUNDWIRE=y
CONFIG_SND_SOC_INTEL_SOUNDWIRE_SOF_MACH=y
# Plain HDA fallback / HDMI audio path
CONFIG_SND_HDA_INTEL=y
CONFIG_SND_HDA_COMPONENT=y
CONFIG_SND_HDA_I915=y
CONFIG_SND_HDA_CODEC_HDMI=y

# --- Storage (3a:00.0 ADATA NVMe) ------------------------------------------
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y

# --- Filesystems ------------------------------------------------------------
# Root filesystem is built in so the NVMe boots without an initramfs; every
# other filesystem is a module.
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_XFS_FS=m
CONFIG_BTRFS_FS=m
CONFIG_F2FS_FS=m
CONFIG_F2FS_FS_XATTR=y
CONFIG_JFS_FS=m
# Removable media / cross-platform (USB sticks, phone SD cards, DVD/Blu-ray).
CONFIG_FAT_FS=y
CONFIG_VFAT_FS=y
CONFIG_MSDOS_FS=y
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_ISO9660_FS=m
CONFIG_UDF_FS=m
# Stacking / pseudo filesystems used by containers and desktop tooling.
CONFIG_SQUASHFS=m
CONFIG_OVERLAY_FS=m
CONFIG_FUSE_FS=m
CONFIG_CUSE=m
CONFIG_AUTOFS_FS=m
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_EFIVAR_FS=y
# Character sets (to mount FAT/exFAT/NTFS names with non-ASCII characters).
CONFIG_NLS_DEFAULT="utf8"
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=m
CONFIG_NLS_UTF8=m
# Network filesystems.
CONFIG_NFS_FS=m
CONFIG_NFS_V3=m
CONFIG_NFS_V4=m
CONFIG_NFS_V4_2=y
CONFIG_CIFS=m
CONFIG_9P_FS=m
CONFIG_9P_FS_POSIX_ACL=y

# --- Device mapper / crypto (dm-crypt, AES-NI) ------------------------------
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_DM_INTEGRITY=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_SHA256=y

# --- Dell platform / WMI ----------------------------------------------------
CONFIG_X86_PLATFORM_DEVICES=y
CONFIG_ACPI_WMI=y
CONFIG_X86_PLATFORM_DRIVERS_DELL=y
# DCDBAS defaults to =m and gates DELL_SMBIOS/DELL_WMI/DELL_LAPTOP, which can
# then only be modules. Build it in so the Dell platform drivers can be =y.
CONFIG_DCDBAS=y
CONFIG_DELL_LAPTOP=y
CONFIG_DELL_WMI=y
CONFIG_DELL_WMI_DESCRIPTOR=y
CONFIG_DELL_WMI_PRIVACY=y
CONFIG_DELL_SMBIOS=y
CONFIG_DELL_SMBIOS_WMI=y
CONFIG_DELL_RBTN=y

# --- Network stack ----------------------------------------------------------
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_INET_DIAG=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_NETWORK_FILESYSTEMS=y

# --- Firewall / netfilter (iptables + nftables; used by libvirt and Docker) -
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_NAT=y
CONFIG_NETFILTER_XTABLES=y
CONFIG_NF_TABLES=m
# nf_tables table families are bool and auto-selected between them.
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_BRIDGE=m
# Current kernels gate the legacy ip(6)tables tables behind these.
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_MANGLE=y
CONFIG_IP_NF_RAW=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_IP6_NF_FILTER=y
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_MANGLE=y
CONFIG_IP6_NF_RAW=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_IPRANGE=m
# IPv4 NAT selects these, so they end up built in rather than modular.
CONFIG_NETFILTER_XT_NAT=y
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=y
# Follows CONFIG_BRIDGE (=m), so it resolves to a module.
CONFIG_BRIDGE_NETFILTER=m

# --- Virtual network devices (VPN, VMs, containers) -------------------------
CONFIG_TUN=m
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_MACVLAN=m
CONFIG_IPVLAN=m
CONFIG_VXLAN=m
CONFIG_GENEVE=m
CONFIG_WIREGUARD=m
CONFIG_VSOCKETS=m
CONFIG_VHOST_VSOCK=m

# --- Virtualization host (KVM) ----------------------------------------------
CONFIG_KVM=m
CONFIG_KVM_INTEL=m
CONFIG_VHOST_NET=m
# The virtio guest drivers (VIRTIO_PCI/BLK/NET/CONSOLE, DRM_VIRTIO_GPU) are
# left at their defconfig default of =y so this kernel also boots as a
# QEMU/KVM guest for testing; only the extra virtio pieces are modular.
CONFIG_VIRTIO_BALLOON=m
CONFIG_VIRTIO_FS=m
CONFIG_SCSI_VIRTIO=m
CONFIG_VFIO=m
CONFIG_VFIO_PCI=m
CONFIG_VFIO_VIRQFD=y

# --- Containers / sandboxes -------------------------------------------------
CONFIG_USER_NS=y
CONFIG_MEMCG=y
CONFIG_CHECKPOINT_RESTORE=y
# eBPF: needed by cgroup-BPF and modern container/network tooling.
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_CGROUP_BPF=y

# --- Webcam (USB UVC) -------------------------------------------------------
CONFIG_MEDIA_SUPPORT=m
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_VIDEO_DEV=m
CONFIG_USB_VIDEO_CLASS=m

# --- Card readers (SD/MMC) --------------------------------------------------
CONFIG_MMC=m
CONFIG_MMC_BLOCK=m
CONFIG_MMC_SDHCI=m
CONFIG_MMC_SDHCI_PCI=m
CONFIG_MMC_SDHCI_ACPI=m

# --- USB networking (docks/tethering), USB-C, USB audio ---------------------
CONFIG_USB_NET_DRIVERS=m
CONFIG_USB_USBNET=m
CONFIG_USB_NET_CDCETHER=m
CONFIG_USB_RTL8152=m
CONFIG_USB_NET_AX88179_178A=m
CONFIG_TYPEC=m
CONFIG_TYPEC_UCSI=m
CONFIG_SND_USB_AUDIO=m

# --- Misc workstation extras ------------------------------------------------
CONFIG_INPUT_UINPUT=m
CONFIG_HIDRAW=y
CONFIG_USB_HIDDEV=y
CONFIG_ZRAM=m

# --- Firmware / EFI boot ----------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- Security / LSM ---------------------------------------------------------
# Yama is required for the kernel.yama.ptrace_scope sysctl in sysctl.conf.
CONFIG_SECURITY_YAMA=y

# --- Core runtime (OpenRC) --------------------------------------------------
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_NAMESPACES=y
CONFIG_CGROUPS=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_FREEZER=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEBUG_INFO_NONE=y
