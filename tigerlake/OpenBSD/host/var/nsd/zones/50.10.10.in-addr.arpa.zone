;	/var/nsd/zones/50.10.10.in-addr.arpa.zone
;
;	Reverse zone for 10.10.50.0/24 (the SRV segment).  Private-space reverse
;	DNS only matters inside the lab, where it makes logs and traceroutes
;	readable, so there is no delegation to arrange upstream.
;
;	Check:  nsd-checkzone 50.10.10.in-addr.arpa /var/nsd/zones/50.10.10.in-addr.arpa.zone
;	Test:   dig @10.10.50.1 -x 10.10.50.13
;
;	Add the matching zone for the DMZ (40.10.10.in-addr.arpa) the same way if
;	you want reverse lookups for the published hosts too.

$ORIGIN 50.10.10.in-addr.arpa.
$TTL 3600

@	IN	SOA	ns.lab.example.org. hostmaster.lab.example.org. (
			2026101301	; serial  YYYYMMDDnn
			3600
			1800
			604800
			3600 )
	IN	NS	ns.lab.example.org.
	IN	NS	ns2.lab.example.org.

; ------------------------------------------------------------------ hosts
1	IN	PTR	gw.lab.example.org.
10	IN	PTR	bastion.lab.example.org.
11	IN	PTR	dns.lab.example.org.
12	IN	PTR	db.lab.example.org.
13	IN	PTR	storage.lab.example.org.
14	IN	PTR	mon.lab.example.org.

; Range reserved for lab hardware with dhcpd(8) reservations.  Add per-host
; PTRs as devices appear; the generic entries below keep a partial reverse
; zone from looking like a broken resolver.
200	IN	PTR	dhcp-200.srv.lab.example.org.
201	IN	PTR	dhcp-201.srv.lab.example.org.
202	IN	PTR	dhcp-202.srv.lab.example.org.
